   "source": [
    "import random\n",
    "\n",
    "a = random.randint(1,10)\n",
    "b = random.randint(1,10)\n",
    "print(\"a + b = \", a + b)\n",
    "print(\"a - b = \", a - b)\n",
    "\n",
    "n = int(input(\"a はいくつ？\"))\n",
    "if a == n:\n",
    "    print(\"正解\")\n",
    "else:\n",
    "    print(\"不正解。正解は \", a)"
   ]
